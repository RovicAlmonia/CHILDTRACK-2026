{
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "CommonJS",
    "moduleResolution":  "node",
    "lib":               ["ES2020"],
    "outDir":            "./dist",
    "rootDir":           "./",
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "lib/**/*",
    "middleware/**/*",
    "routes/**/*",
    "controllers/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}