{
  "compilerOptions": {
    "target":             "ES2020",
    "module":             "CommonJS",
    "moduleResolution":   "node10",
    "lib":                ["ES2020"],
    "outDir":             "./dist",
    "rootDir":            "./",
    "strict":             false,
    "esModuleInterop":    true,
    "skipLibCheck":       true,
    "resolveJsonModule":  true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "server.ts",
    "lib/**/*",
    "middleware/**/*",
    "routes/**/*",
    "controllers/**/*",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
